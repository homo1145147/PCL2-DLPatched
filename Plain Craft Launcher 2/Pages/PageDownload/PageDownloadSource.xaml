<local:MyPageRight x:Class="PageDownloadSource"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PCL"
    mc:Ignorable="d"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10,25,25">

            <local:MyCard Margin="0,15" Title="添加自定义源">
                <StackPanel Margin="25,40,25,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="名称" Margin="0,0,25,0" />
                        <local:MyTextBox x:Name="TextSourceName" Grid.Column="1" HintText="例如：工会 CDN" />
                        <TextBlock VerticalAlignment="Center" Text="地址" Margin="0,0,25,0" Grid.Row="2" />
                        <local:MyTextBox x:Name="TextSourceUrl" Grid.Row="2" Grid.Column="1" HintText="例如：https://cdn.example.com" />
                    </Grid>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6" Margin="0,10,0,0"
                               Text="镜像需保持 Mojang 的目录结构：在根地址下按官方域名分区，例如 {根}/launchermeta.mojang.com/mc/game/version_manifest.json。" />
                    <local:MyButton x:Name="BtnAddSource" Text="添加" MinWidth="120" Padding="13,0" HorizontalAlignment="Left" Margin="0,12,0,0" Click="BtnAddSource_Click" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="源列表">
                <StackPanel Margin="25,40,25,18">
                    <TextBlock Text="列表顺序即优先级：靠前的源会先被尝试。内置源不可删除。" TextWrapping="Wrap" FontSize="12" Opacity="0.6" Margin="0,0,0,12" />
                    <StackPanel x:Name="PanSourceList" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="操作">
                <StackPanel Margin="25,40,25,18">
                    <WrapPanel>
                        <local:MyButton x:Name="BtnReset" Text="恢复默认" MinWidth="120" Padding="13,0" Margin="0,0,15,0" Click="BtnReset_Click" />
                        <local:MyButton x:Name="BtnTest" Text="测试第一个启用的源" MinWidth="180" Padding="13,0" Margin="0,0,15,0" Click="BtnTest_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="LabTestResult" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0" Visibility="Collapsed" />
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
